, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Look at this graphic novel about Batman!", "type": "example"}, {"content": "engenn3le02ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "illustration ", "type": "name"}, {"content": "a picture; a drawing of something or someone ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: This graphic novel has some amazing illustrations!", "type": "example"}, {"content": "engenn3le02ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "realistic ", "type": "name"}, {"content": "life-like; very much like real life ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Superman is not realistic. No one can fly like that!", "type": "example"}, {"content": "engenn3le02ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "fantasy ", "type": "name"}, {"content": "things that are not real ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Superheroes are a fantasy. They only exist in our mind.", "type": "example"}, {"content": "engenn3le02ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "popular culture ", "type": "name"}, {"content": "music, books, sports, or art that are popular", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: In Colombia, soccer is a large part of popular culture.", "type": "example"}, {"content": "engenn3le02ob01aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": " sidekick ", "type": "name"}, {"content": "a superhero's assistant; a partner ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Batman's sidekick is Robin.", "type": "example"}, {"content": "engenn3le02ob01aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"cont