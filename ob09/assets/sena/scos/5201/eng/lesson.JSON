plate_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn3le02ob09re2aud01", "coverimg": "engenn3le02ob09re2img05.jpg", "images": [{"image": "engenn3le02ob09re2img05.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn3le02ob09re2img05.jpg", "text": "<span class=\"strong\">Sally</span>:      Thanks for helping me to set up the stand, Peter.<br />\n<span class=\"strong\">Peter</span>:      No problem! Thanks for getting the discount ticket!", "time": "7000", "id": 1}, {"image": "engenn3le02ob09re2img05.jpg", "text": "<span class=\"strong\">Sally</span>:      I want to look around, but I can't take a break until lunch.<br />\n<span class=\"strong\">Peter</span>:      I have a suggestion.", "time": "13500", "id": 2}, {"image": "engenn3le02ob09re2img05.jpg", "text": "<span class=\"strong\">Sally</span>:      Oh, what's that?<br />\n<span class=\"strong\">Peter</span>:      I could help you, and then we could look around together.", "time": "20000", "id": 3}, {"image": "engenn3le02ob09re2img01.jpg", "text": "<span class=\"strong\">Sally</span>:      That would be great. Thanks.<br />\n<span class=\"strong\">Peter</span>:      No problem.<br />\n<span class=\"strong\">Sally</span>:      We're like superheroes. I'm Batman, and you're my sidekick, Robin!", "time": "26600", "id": 4}, {"image": "engenn3le02ob09re2img05.jpg", "text": "<span class=\"strong\">Peter</span>:     Ha! There are so many interesting exhibits here. The vendors are really fun too.<br />\n<span class=\"strong\">Sally</span>:      I know! I want to be free!", "time": "39000", "id": 5}, {"image": "engenn3le02ob09re2img02.jpg", "text": "<span class=\"strong\">Peter</span>:      Soon ... it's almost lunch time.<br />\n<span class=\"strong\">Sally</span>:      I'm getting hungry too. Hey, what are you eating? Chocolate?<br />\n<span class=\"strong\">Peter</span>:      Uh ... yeah. Do you want some? <br />\n<span class=\"strong\">Sally</span>:   Yes, please!", "time": "51000", "id": 6}]}}], "id": 1}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "At the Comic Book Store", "type": "lesson_name"}, {"content": "So Much to Do", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 2, "type": "lesson"}, {"content": "A1.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately explain information about interests, hobbies and preferences in communicative situations.", "type": "primary"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_1"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_2"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_3"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_4"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_5"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_6"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_7"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Talking About Problems and Solutions", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "When you talk about problems at work, you can use the Simple Present tense or modals for suggestion. For example: <br><br><span class=\"italic\">We have a small problem.<br> There is a misunderstanding.<br> We have an issue.<br> Can we discuss this?<br> What do you think?</span>", "type": "text"}, {"content": " You can use these phrases to suggest solutions:", "type": "text"}, {"content": "<span class=\"italic\">I have an idea.</span><br/> <span class=\"italic\">I have a suggestion.</span> <br/><span class=\"italic\">We could \u2026 <br />Why don't you \u2026 <br />You should \u2026</span>", "type": "text"}, {"content": "<span class=\"strong\">Anne</span>: We have a small problem.<br /><span class=\"strong\">Carol</span>: We could talk to Mark about it.", "type": "example"}, {"content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\">To start</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\">To Reply</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We have a small problem. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Oh, what is it?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"There is a misunderstanding. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Oh, what's that?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We have an issue.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"What's the issue?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Can we discuss this? \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Of course.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"What do you think?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Let's talk about it.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "to set up ", "type": "name"}, {"content": "to arrange things in a display ", "type": "definition"}, {"content": "(phrasal verb)", "type": "part_speech"}, {"content": "Example: Can you help me set up the stand today?", "type": "example"}, {"content": "engenn3le02ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use at a convention.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": " to look around ", "type": "name"}, {"content": "to look at different things", "type": "definition"}, {"content": "(phrasal verb)", "type": "part_speech"}, {"content": "Example: I want to look around at the convention.", "type": "example"}, {"content": "engenn3le02ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to take a break", "type": "name"}, {"content": " to rest", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": " Example: I can't take a break until lunch.", "type": "example"}, {"content": "engenn3le02ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "exhibit ", "type": "name"}, {"content": "display of art ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The comic book exhibits are fantastic.", "type": "example"}, {"content": "engenn3le02ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "vendor ", "type": "name"}, {"content": "a person who sells something at a convention ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The vendors are fun.", "type": "example"}, {"content": "engenn3le02ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to be free", "type": "name"}, {"content": " to not have work to do", "type": "definition"}, {"content": " (expression)", "type": "part_speech"}, {"content": "Example: I am free at lunch time. We can look around then.", "type": "example"}, {"content": "engenn3le02ob09aud06", "type": "audio"}]}, {"content": "engenn3le02ob09re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "What do you like to do in your free time?", "type": "text"}, {"content": "Write a short dialogue where you suggest hobbies to your partner (6 - 7 lines).", "type": "text"}, {"content": "Practice your dialogue aloud with your partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write a dialogue about hobbies and interests.", "type": "text"}, {"content": "I make suggestions.", "type": "text"}, {"content": "I practice my dialogue with my partner.", "type": "text"}]}]}