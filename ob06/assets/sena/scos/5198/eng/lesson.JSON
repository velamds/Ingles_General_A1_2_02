": "text"}, {"content": "Change roles and practice again.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Role 1: </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It is your first day at work. You are nervous. The clerk tells you about a problem. You make a suggestion to help.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Role 2:</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You are a clerk at a bookstore. You have a small problem. The books are not organized. Ask the new clerk to organize them alphabetically.\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write a dialogue about a situation in a work setting.", "type": "text"}, {"content": "I make suggestions.", "type": "text"}, {"content": "I talk about problems and solutions.", "type": "text"}]}]}